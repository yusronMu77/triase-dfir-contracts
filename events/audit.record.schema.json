{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astria.local/contracts/events/audit.record.schema.json",
  "title": "AuditRecord",
  "description": "data untuk audit.record v1 (jalur asinkron) dan isi POST /internal/v1/records (jalur sinkron). Penerbit: semua layanan. Konsumen: audit. Payload maks 4 KiB, tanpa angka pecahan, tanpa nilai rahasia.",
  "type": "object",
  "additionalProperties": false,
  "required": ["idempotency_key", "occurred_at", "actor", "actor_type", "action", "target_type", "target_id", "via", "payload"],
  "properties": {
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {"description": "usr_... untuk pengguna, svc:<nama> untuk layanan.", "type": "string", "minLength": 1, "maxLength": 64},
    "actor_type": {"type": "string", "enum": ["user", "service", "system"]},
    "action": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$", "maxLength": 100},
    "target_type": {"type": "string", "minLength": 1, "maxLength": 64},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "via": {"type": "string", "enum": ["ui", "api", "bot", "cli", "system"]},
    "payload": {"type": "object"}
  }
}
